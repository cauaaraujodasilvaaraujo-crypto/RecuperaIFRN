generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  matricula Int      @id
  nome      String   @db.VarChar(200)
  email     String?  @unique @db.VarChar(150)
  senha     String?  @db.VarChar(255)
  coapac    Boolean  @default(false)
  criadoEm  DateTime @default(now())

  itensCadastrados Item[] @relation("ItemCadastradoPor")
  itensRetirados   Item[] @relation("ItemRetiradoPor")

  @@map("usuarios")
}

model Classificacao {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(60)

  itens Item[]

  @@map("classificacoes")
}

enum TipoRegistro {
  PERDIDO
  ENCONTRADO
}

enum StatusItem {
  DISPONIVEL
  RETIRADO
}

model Item {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(100)
  descricao String? @db.VarChar(300)
  cor       String? @db.VarChar(45)

  classificacaoId Int
  classificacao   Classificacao @relation(fields: [classificacaoId], references: [id])

  tipo   TipoRegistro @default(ENCONTRADO)
  status StatusItem   @default(DISPONIVEL)

  dataEncontrado  DateTime @db.Date
  localEncontrado String   @db.VarChar(300)
  foto            String?  @db.VarChar(300)

  dataEntrega  DateTime? @db.Date
  localEntrega String?   @db.VarChar(300)

  cadastradoPorMatricula Int
  cadastradoPor          Usuario @relation("ItemCadastradoPor", fields: [cadastradoPorMatricula], references: [matricula])

  retiradoPorMatricula Int?
  retiradoPor          Usuario? @relation("ItemRetiradoPor", fields: [retiradoPorMatricula], references: [matricula])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([dataEncontrado])
  @@map("itens")
}